# SMTP Configuration for sending emails from admin@onestopkwc.ca
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@onestopkwc.ca
SMTP_PASS=your-app-password-here
SMTP_FROM=admin@onestopkwc.ca

# Email deadline shown in the template
DEADLINE=Monday, August 24, 2026

# Server port (default: 3000)
PORT=3000
